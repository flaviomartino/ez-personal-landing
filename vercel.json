{
  "buildCommand": null,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?ez-?academia\\.com\\.br"
        }
      ],
      "destination": "/academias.html"
    }
  ],
  "redirects": [
    {
      "source": "/academias",
      "destination": "/academias.html",
      "permanent": false
    }
  ]
}
